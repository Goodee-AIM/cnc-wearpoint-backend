CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_STORAGE_ROOT=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# 공통 재생 제어용 서버 운영자 토큰. 프런트 VITE_ 변수에 넣지 않습니다.
MONITORING_CONTROL_TOKEN=

# 브라우저 접속과 독립적으로 공통 재생 알림 생성
MONITORING_ALERT_WORKER_ENABLED=1
# 기존 alerts의 저장 시각 기준. 한국 시각이면 540, UTC이면 0
LEGACY_ALERTS_UTC_OFFSET_MINUTES=540
